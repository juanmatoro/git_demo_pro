---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import FiltroCategoria from '../../components/FiltroCategoria.jsx';
import BuscadorRecetas from '../../components/BuscadorRecetas.jsx';

const todas = await getCollection('recetas', ({ data }) => data.publicado);

const categorias = [...new Set(todas.map((r) => r.data.categoria))].sort();

const recetas = todas.map((r) => ({
  slug: r.id.replace(/\.md$/, ''),
  title: r.data.title,
  descripcion: r.data.descripcion,
  categoria: r.data.categoria,
  tags: r.data.tags,
  imagen: r.data.imagen,
}));
---

<Layout title="Recetas">
  <header>
    <h1>Todas las recetas</h1>
    <p>{todas.length} recetas publicadas.</p>
  </header>

  <section class="controles">
    <FiltroCategoria categorias={categorias} client:load />
    <BuscadorRecetas recetas={recetas} client:load />
  </section>
</Layout>

<style>
  .controles {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }
</style>
