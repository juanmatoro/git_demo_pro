---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const recetas = await getCollection('recetas', ({ data }) => data.publicado);
const total = recetas.length;
const categorias = [...new Set(recetas.map((r) => r.data.categoria))];
---

<Layout title="Inicio">
  <section class="hero">
    <h1>Recetario Casero</h1>
    <p class="subtitulo">Sandbox para aprender Git con cosas que se comen.</p>
  </section>

  <section class="intro">
    <h2>Bienvenida</h2>
    <p>
      Este sitio está hecho con <strong>Astro</strong> (sobre Vite) y lee las recetas
      directamente desde archivos <code>.md</code>. Es el laboratorio práctico del
      <a href={`${base}/readme`}>README de Git en Profundidad</a>
      que vive en la raíz del repo.
    </p>
    <p>
      Cada vez que agregues una receta, modifiques un ingrediente o ramifiques
      el repo, estás practicando un módulo distinto del laboratorio. Mira la
      guía de <a href={`${base}/practicas`}>prácticas por módulo</a> para ver el mapeo.
    </p>
  </section>

  <section class="stats">
    <div class="card">
      <span class="num">{total}</span>
      <span class="label">recetas publicadas</span>
    </div>
    <div class="card">
      <span class="num">{categorias.length}</span>
      <span class="label">categorías</span>
    </div>
    <div class="card">
      <a href={`${base}/recetas`}>Ver todas &rarr;</a>
    </div>
  </section>

  <section class="proximas">
    <h2>Ideas para ramificar</h2>
    <p>
      Buenas excusas para crear ramas <code>feature/...</code> y practicar merge / rebase:
    </p>
    <ul>
      <li>Postres (flan, brownies, tarta de manzana)</li>
      <li>Bebidas (limonada, smoothie, té frío)</li>
      <li>Desayunos (granola, pancakes, tostadas)</li>
      <li>Menús completos para una cena (ver <a href={`${base}/menus`}>/menus</a>)</li>
    </ul>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    margin: 16px 0 32px;
  }

  .hero h1 {
    font-size: 2.4rem;
    color: #c97b3c;
    margin: 0;
  }

  .subtitulo {
    font-style: italic;
    color: #6b6b6b;
    margin: 4px 0 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin: 24px 0;
  }

  .card {
    background: #fff;
    border: 1px solid #e6dfd2;
    border-radius: 6px;
    padding: 16px;
    text-align: center;
  }

  .num {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    color: #c97b3c;
  }

  .label {
    color: #6b6b6b;
    font-size: 0.85rem;
  }

  .card a {
    color: #c97b3c;
    text-decoration: none;
    font-weight: bold;
  }

  .card a:hover {
    text-decoration: underline;
  }
</style>
