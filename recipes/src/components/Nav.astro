---
const base = import.meta.env.BASE_URL;
const { pathname } = Astro.url;

const links = [
  { href: base, label: 'Inicio' },
  { href: `${base}/recetas`, label: 'Recetas' },
  { href: `${base}/menus`, label: 'Menús' },
  { href: `${base}/practicas`, label: 'Prácticas Git' },
  { href: `${base}/astro`, label: 'Aprende Astro' },
];

function isActive(href: string) {
  if (href === base) return pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
  return pathname.startsWith(href);
}
---

<nav class="nav">
  <a href={base} class="logo">Recetario de Git</a>
  <ul>
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class={isActive(href) ? 'active' : ''}>{label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 2px solid #c97b3c;
    margin-bottom: 24px;
  }

  .logo {
    font-size: 1.4rem;
    font-weight: bold;
    color: #c97b3c;
    text-decoration: none;
  }

  ul {
    list-style: none;
    display: flex;
    gap: 18px;
    padding: 0;
    margin: 0;
  }

  a {
    color: #5a3a1f;
    text-decoration: none;
    font-size: 0.95rem;
  }

  a:hover {
    color: #c97b3c;
  }

  a.active {
    color: #c97b3c;
    font-weight: bold;
    border-bottom: 2px solid #c97b3c;
    padding-bottom: 2px;
  }
</style>
